    { "name": "Stabs 2",   "patch": "snappy_pluck",   "transpose": 7,   "hold": 0.25, "offsetBeats": 0.25, "gain": 0.26, "stabBeats": 0.5 },
    { "name": "Lead stack","patch": "screaming_lead", "transpose": 0,   "hold": 0.50, "offsetBeats": 0,    "gain": 0.22, "stabBeats": 2 },
    { "name": "Poly bass", "patch": "control_bass",   "transpose": -7,  "hold": 0.60, "offsetBeats": 0,    "gain": 0.30, "stabBeats": 1, "params": { "mono": 0, "ampR": 0.25, "filR": 0.25, "cutoff": 600 } }
